# Local settings for the 3DClash server. Copy to .env at the repo root (never committed), fill in what you need.
# The server reads it before any of its settings, so every variable in
# docs/architecture/15-requirements-settings-and-config.md can go here; restart the server after a change.
# Real environment variables win over this file. No quotes around values. A number left empty is the same as unset.

# Muse Spark on Meta's Model API: proposals, chat, plans, patterns, report text. Needed for anything that asks Muse Spark.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
# Reasoning effort: minimal | low | medium | high, or empty for the API's default.
META_REASONING_EFFORT=low

# Bulk triage on Muse Spark Open (Baseten). Without a key, triage uses Muse Spark above.
TRIAGE_API_KEY=
# TRIAGE_API_BASE_URL=https://inference.baseten.co/v1
# TRIAGE_MODEL=meta-models/muse-spark-open
# TRIAGE_REASONING_EFFORT=
# CLASH3D_TRIAGE_WORKERS=8

# Owner settings (gear in the header, open the page with #owner). At least 24 characters; make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLASH3D_OWNER_TOKEN=

# Demo caps (the Modal deploy sets them). 0 is no limit. Unset or empty takes the default, which is no limit, except
# new requirements files (120 an hour per visitor) and requirement previews (60 an hour per visitor).
# CLASH3D_PROPOSE_PER_HOUR=20
# CLASH3D_PROPOSE_PER_DAY=300
# CLASH3D_CHAT_PER_HOUR=40
# CLASH3D_CHAT_PER_DAY=1500
# CLASH3D_VOICE_PER_HOUR=60
# CLASH3D_VOICE_PER_DAY=2000
# CLASH3D_REQUIREMENTS_PER_HOUR=120
# CLASH3D_PREVIEW_PER_HOUR=60
# Live voice: how long a hands-free session may keep the mic open (hold to talk is 60 s).
# CLASH3D_VOICE_LIVE_MAX_S=120

# Wider-fix search bounds. Positive values can lower these hard ceilings; owner settings keep these limits.
# CLASH3D_CONTEXT_MODEL_CALLS=6
# CLASH3D_CONTEXT_TRIALS=12
# CLASH3D_CONTEXT_SECONDS=120
# CLASH3D_CONTEXT_ALTERNATIVES=3
# CLASH3D_CONTEXT_RADIUS_M=2.5
